<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- WebView Principal do Kiosk em Tela 100% Cheia -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Container para exibição de Vídeo Fullscreen HTML5 -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Barra de progresso discreta de carregamento -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="#00E5FF"
        android:visibility="gone" />

    <!-- Área de Toque Oculta no Canto Superior Esquerdo (Gesto de 7 Toques) -->
    <View
        android:id="@+id/hotspotTopLeft"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Área de Toque Oculta no Canto Inferior Direito (Gesto de 7 Toques) -->
    <View
        android:id="@+id/hotspotBottomRight"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|end"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Botão Flutuante Circular de Desbloqueio Kiosk (Estilo Fully Kiosk) -->
    <FrameLayout
        android:id="@+id/btnKioskUnlock"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_unlock_button"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="#000000" />
    </FrameLayout>

</FrameLayout>
